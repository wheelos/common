load("@rules_cuda//cuda:defs.bzl", "cuda_library", "cuda_test")

cc_library(
    name = "types",
    hdrs = [
        "status.h",
        "types.h",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cuda_stream",
    hdrs = [
        "runtime/cuda_stream.h",
        "runtime/cuda_types.h",
    ],
    visibility = ["//visibility:public"],
)

cuda_library(
    name = "buffer",
    srcs = ["memory/buffer.cu"],
    hdrs = ["memory/buffer.h"],
    includes = [".."],
    deps = [
        ":cuda_stream",
        ":types",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "buffer_pool",
