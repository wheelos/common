    hdrs = [
        "core/point_cloud.h",
        "core/point_cloud_buffer.h",
        "core/rigid_transform.h",
    ],
    deps = [
        ":buffer",
        ":cuda_stream",
        ":types",
        "@eigen//:eigen",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "range_image_api",
    hdrs = [
        "range_image/range_image.h",
        "range_image/range_image_builder.h",
    ],
    deps = [
        ":buffer",
        ":core",
        ":cuda_stream",
        ":types",
    ],
    visibility = ["//visibility:public"],
)

cuda_library(
    name = "range_image",
    srcs = ["range_image/range_image_builder.cu"],
    deps = [
        ":range_image_api",
    ],
    visibility = ["//visibility:public"],
)

cuda_library(
    name = "filter",
    srcs = [
        "filter/crop_box_filter.cu",
        "filter/decimation_filter.cu",
        "filter/internal/device_filter_utils.cuh",
    ],
    hdrs = [
        "filter/crop_box_filter.h",
        "filter/decimation_filter.h",
    ],
    includes = [".."],
    deps = [
        ":buffer",
        ":core",
        ":cuda_stream",
        ":types",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "pointcloud",
    deps = [
        ":buffer",
        ":buffer_pool",
        ":core",
        ":filter",
        ":range_image",
        ":range_image_api",
        ":cuda_stream",
        ":types",
    ],
    visibility = ["//visibility:public"],
)

