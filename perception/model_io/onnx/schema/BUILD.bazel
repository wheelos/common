load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//perception/model_io/onnx:__pkg__"])

proto_library(
    name = "onnx_proto",
    srcs = [
        "onnx-ml.proto",
        "onnx-operators-ml.proto",
    ],
    strip_import_prefix = "/perception/model_io/onnx/schema",
)

cc_proto_library(
    name = "onnx_proto_cc",
    deps = [":onnx_proto"],
)
